# Catalog Manager environment file. Copy to .env; never commit .env.
# For on-disk overrides, see catalog/settings/local_settings.example.py.
# Django settings reference: https://docs.djangoproject.com/en/5.2/ref/settings/

# --- Security -------------------------------------------------------------
# 50+ random characters. Required when DEBUG is off.
# https://docs.djangoproject.com/en/5.2/ref/settings/#secret-key
SECRET_KEY=change-me-to-50-random-chars

# 0 in production; 1 only while developing.
# https://docs.djangoproject.com/en/5.2/ref/settings/#debug
DEBUG=0

# Host names Django may serve, comma-separated.
# https://docs.djangoproject.com/en/5.2/ref/settings/#allowed-hosts
ALLOWED_HOSTS=catalog.example.org

# HTTPS origins trusted for forms, comma-separated.
# https://docs.djangoproject.com/en/5.2/ref/settings/#csrf-trusted-origins
CSRF_TRUSTED_ORIGINS=https://catalog.example.org

# Secure cookies are on by default when DEBUG=0; 1 pins them on.
# https://docs.djangoproject.com/en/5.2/ref/settings/#session-cookie-secure
# https://docs.djangoproject.com/en/5.2/ref/settings/#csrf-cookie-secure
SECURE_COOKIES=1

# Enable only when the proxy sends X-Forwarded-Proto, or HTTPS loops.
# https://docs.djangoproject.com/en/5.2/ref/settings/#secure-ssl-redirect
# SSL_REDIRECT=1
# ADMIN_URL=admin
LOG_LEVEL=INFO
# Session lifetime in seconds.
# https://docs.djangoproject.com/en/5.2/ref/settings/#session-cookie-age
SESSION_AGE=43200
# Password-set links expire after this many seconds.
# https://docs.djangoproject.com/en/5.2/ref/settings/#password-reset-timeout
RESET_TIMEOUT=7200
TIME_ZONE=America/New_York

# --- Database -------------------------------------------------------------
# Django's auth tables live in this schema beside the catalog tables.
# If you change the search_path in local_settings, change this too.
# https://docs.djangoproject.com/en/5.2/ref/settings/#databases
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=gutenberg
PGUSER=gutenberg
# PGPASSWORD=  # optional; libpq also reads ~/.pgpass
# PGSSLMODE=require
DB_SCHEMA=django

# --- Rate limits and display ----------------------------------------------
CATALOG_PAGE_SIZE=50
CATALOG_RATE_LOGIN=10/m
CATALOG_RATE_LOGIN_USER=10/m
CATALOG_RATE_POST=60/m
# Only these proxy addresses may supply X-Real-IP for rate limiting.
CATALOG_TRUSTED_PROXIES=127.0.0.1,::1
# Users in this Django group may use the site; `manage.py migrate` creates it.
CATALOGUER_GROUP=cataloguer

# --- Optional paths -------------------------------------------------------
# CACHE_DIR=/var/lib/catalog_manager/cache
# LOG_DIR=/var/lib/catalog_manager/logs
